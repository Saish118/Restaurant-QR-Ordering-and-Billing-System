enum order_source {
  STAFF
  QR
}

enum order_status {
  NEW
  READY
  SERVED
  CANCELLED
}

enum payment_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum restaurant_role {
  OWNER
  WAITER
  CHEF
}

enum restaurant_status {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
  EXPIRED
}

enum session_status {
  OPEN
  BILLING
  CLOSED
  CANCELLED
}
