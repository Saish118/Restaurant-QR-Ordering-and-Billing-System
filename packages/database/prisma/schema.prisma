  dining_sessions   dining_sessions @relation(fields: [restaurant_id, dining_session_id], references: [restaurant_id, id], onDelete: NoAction, onUpdate: NoAction)
  restaurants       restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([restaurant_id, dining_session_id], map: "guest_capabilities_session_idx")
}

