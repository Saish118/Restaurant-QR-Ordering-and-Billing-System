generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id String?      @db.Uuid
  actor_id      String       @db.Uuid
  action        String
  target_id     String?      @db.Uuid
  details       Json         @default("{}")
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  restaurants   restaurants? @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([restaurant_id, created_at], map: "audit_logs_tenant_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bills {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String          @db.Uuid
  dining_session_id String          @db.Uuid
  subtotal_minor    BigInt          @default(0)
  tax_minor         BigInt          @default(0)
  total_minor       BigInt          @default(0)
  finalized_at      DateTime?       @db.Timestamptz(6)
  dining_sessions   dining_sessions @relation(fields: [restaurant_id, dining_session_id], references: [restaurant_id, id], onDelete: NoAction, onUpdate: NoAction)
  restaurants       restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments          payments[]

  @@unique([restaurant_id, dining_session_id])
  @@unique([restaurant_id, id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model dining_sessions {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id      String               @db.Uuid
  table_id           String               @db.Uuid
  status             session_status       @default(OPEN)
  version            Int                  @default(1)
  opened_at          DateTime             @default(now()) @db.Timestamptz(6)
  closed_at          DateTime?            @db.Timestamptz(6)
  bills              bills?
  restaurants        restaurants          @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tables             tables               @relation(fields: [restaurant_id, table_id], references: [restaurant_id, id], onDelete: NoAction, onUpdate: NoAction)
  guest_capabilities guest_capabilities[]
  orders             orders[]
  service_requests   service_requests[]

  @@unique([restaurant_id, id])
  @@unique([restaurant_id, table_id], map: "one_live_session_per_table", where: raw("(status = ANY (ARRAY['OPEN'::session_status, 'BILLING'::session_status]))"))
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model guest_capabilities {
