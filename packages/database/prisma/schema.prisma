/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurant_id     String          @db.Uuid
  dining_session_id String          @db.Uuid
  source            order_source
  status            order_status    @default(NEW)
  idempotency_key   String          @db.Uuid
  request_hash      String
  actor_type        String
  actor_id          String          @db.Uuid
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  order_items       order_items[]
  dining_sessions   dining_sessions @relation(fields: [restaurant_id, dining_session_id], references: [restaurant_id, id], onDelete: NoAction, onUpdate: NoAction)
  restaurants       restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([restaurant_id, dining_session_id, idempotency_key])
  @@unique([restaurant_id, id])
  @@index([restaurant_id, status, created_at], map: "orders_kitchen_idx")
  @@index([restaurant_id, dining_session_id, created_at], map: "orders_session_idx")
  @@index([created_at], map: "orders_platform_date_idx")
}

